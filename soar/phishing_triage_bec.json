{"workflow_as_code":false,"actions":[{"name":"execute_python","label":"Score_Alert","app_name":"Shuffle Tools","app_version":"1.2.0","app_id":"3e2bdf9d5069fe3f4746c29d68785a6a","sharing":true,"private_id":"","description":"Runs python with the data input. Any prints will be returned. Avoid __main__ as it is not supported in this environment.","environment":"cloud","errors":[],"id_":"6ba887d6-6881-47c2-8cd9-004ffdf2eef2","_id_":"6ba887d6-6881-47c2-8cd9-004ffdf2eef2","id":"27defcc9-7837-4d55-802f-639ab32953b6","is_valid":true,"type":"ACTION","parameters":[{"description":"The code to run. Can be a file ID from within Shuffle.","id":"","name":"code","example":"print(\"hello world\")","value":"import json\nimport re\n\nalert = json.loads(r\"\"\"$exec\"\"\")\n\ndef get_domain(email_address):\n    match = re.search(r\"@([\\w.-]+)\", email_address)\n    return match.group(1).lower() if match else None\n\nPAYMENT_WORDS = (\"bank details\", \"remittance\", \"payment details\")\n\nsignals = {}\nsignals[\"reply_to_mismatch\"] = alert[\"reply_to\"] != \"\" and get_domain(alert[\"reply_to\"]) != alert[\"sender_domain\"]\nsignals[\"night_hour\"] = 0 <= int(alert[\"timestamp\"][11:13]) <= 5\nsignals[\"payment_keywords\"] = any(word in alert[\"subject\"].lower() for word in PAYMENT_WORDS)\nsignals[\"unusual_country\"] = alert[\"sender_domain\"].endswith(\".com.ar\") and alert[\"sender_country\"] != \"AR\"\n\nWEIGHTS = {\"reply_to_mismatch\": 35, \"night_hour\": 10, \"payment_keywords\": 20, \"unusual_country\": 35}\n\nscore = 0\nfor name, is_on in signals.items():\n    if is_on:\n        score += WEIGHTS[name]\n\nif score >= 45:\n    decision = \"block\"\nelif score >= 20:\n    decision = \"analyst\"\nelse:\n    decision = \"allow\"\n\nprint(json.dumps({\"alert\": alert[\"alert\"], \"sender\": alert[\"sender\"], \"score\": score, \"decision\": decision, \"signals\": signals}))","multiline":true,"multiselect":false,"options":null,"action_field":"","variant":"","required":true,"config